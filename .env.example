# Runtime
NODE_ENV=production

# Database
DB_PATH=./rebuild.db
SESSION_DB_PATH=./sessions.db

# App
APP_TIMEZONE=America/Puerto_Rico
PORT=3000
ENABLED_SECTIONS=all

# Sessions
SESSION_SECRET=
SESSION_ENCRYPTION_KEY=
TRUST_PROXY=false
COOKIE_SECURE=
COOKIE_SAMESITE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_TIMEZONE=

# Backups
ENABLE_IN_PROCESS_BACKUPS=false
BACKUP_RUN_ON_STARTUP=true
BACKUP_INTERVAL_HOURS=24
BACKUP_DAILY_RETENTION_COUNT=30
BACKUP_MONTHLY_RETENTION_COUNT=12
# Optional: absolute or relative path for backup snapshots
BACKUP_DIR=./backups

# Retention (days)
NOTIFICATION_RETENTION_DAYS=90
PHOTO_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
IDEMPOTENCY_RETENTION_DAYS=30

# QuickBooks
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
# Optional: defaults to production (https://quickbooks.api.intuit.com/v3/company)
QBO_API_BASE=
# Optional: set true to log QBO queries/responses in dev
QBO_DEBUG=
# QBO_REALM_ID is stored per org after OAuth; no env var needed.

# APNs
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aviangp.com

# SMTP (Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
