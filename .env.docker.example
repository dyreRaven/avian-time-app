NODE_ENV=production
PORT=3000
HOST_PORT=3000

# Required database locations in-container
DB_PATH=/app/data/rebuild.db
SESSION_DB_PATH=/app/data/sessions.db

# App features (all|clock|clock,payroll|clock,shipments|clock,payroll,shipments)
ENABLED_SECTIONS=all

# App settings
APP_TIMEZONE=America/Puerto_Rico
TRUST_PROXY=false
COOKIE_SECURE=
COOKIE_SAMESITE=
ENABLE_IN_PROCESS_BACKUPS=false
BACKUP_RUN_ON_STARTUP=true
BACKUP_INTERVAL_HOURS=24
BACKUP_DAILY_RETENTION_COUNT=30
BACKUP_MONTHLY_RETENTION_COUNT=12
BACKUP_DIR=/app/data/backups

# Secrets (required for production auth/security)
SESSION_SECRET=
SESSION_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_TIMEZONE=
