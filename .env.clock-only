# Clock-only profile (time/clock-in only)
# Copy this file for deployment or use as docker-compose --env-file

NODE_ENV=production
PORT=3000
HOST_PORT=3000

DB_PATH=/app/data/rebuild.db
SESSION_DB_PATH=/app/data/sessions.db

ENABLED_SECTIONS=clock

APP_TIMEZONE=America/Puerto_Rico
TRUST_PROXY=false
COOKIE_SECURE=
COOKIE_SAMESITE=

SESSION_SECRET=
SESSION_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_TIMEZONE=
